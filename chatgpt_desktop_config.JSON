{
    "mcpServers":  {
                       "desktop-commander":  {
                                                 "args":  [
                                                              "run",
                                                              "-i",
                                                              "--rm",
                                                              "-v",
                                                              "dc-system:/usr",
                                                              "-v",
                                                              "dc-home:/root",
                                                              "-v",
                                                              "dc-workspace:/workspace",
                                                              "-v",
                                                              "dc-packages:/var",
                                                              "-v",
